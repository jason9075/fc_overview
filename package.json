{
  "name": "matrix-1s-5in1-ii-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive Three.js explorer for the BETAFPV Matrix 1S Brushless Flight Controller (5IN1 II)",
  "author": "Jason Kuan (jason9075)",
